# Kopieer dit bestand naar .env en vul in. Deel .env nooit met anderen.
ANTHROPIC_API_KEY=sk-ant-...

# Bitvavo API-key: alleen "bekijken" en "handelen" aanzetten, NOOIT "opnemen".
# Zet daarnaast een IP-whitelist aan in Bitvavo.
BITVAVO_KEY=
BITVAVO_SECRET=

# Eerst false laten staan: de bot beslist wel, maar plaatst geen echte orders.
LIVE=false

# Markten en tempo
MARKETS=BTC-EUR,ETH-EUR,SOL-EUR,XRP-EUR
CYCLE_MINUTES=120

# Modellen: standaard Haiku voor alles (ongeveer $1 per maand).
MODEL=claude-haiku-5-5
# MODEL_CHIEF=claude-sonnet-5-5

# Budget, stop-loss en alle risicoregels staan in rules.json.
